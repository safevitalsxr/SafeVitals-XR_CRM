# ───────────────────────────────────────────────────────────────────────────
# Safe Vitals XR — Backend Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ───────────────────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# MongoDB — replace with your Atlas or local URI
MONGODB_URI=mongodb://localhost:27017/safevitals

# JWT & Session Security — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING_IN_PRODUCTION

# OTP Security (reserved for future TOTP-based OTP if needed)
OTP_SECRET=CHANGE_ME_OTP_SECRET

# Supabase — used for Storage and optional Realtime
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Provider — transactional email for OTPs, invitations, resets
# Resend: https://resend.com | SendGrid: https://sendgrid.com
EMAIL_PROVIDER_KEY=your-email-api-key
EMAIL_FROM=noreply@safevitals.com
