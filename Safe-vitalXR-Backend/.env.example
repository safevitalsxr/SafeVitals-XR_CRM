# SafeVitals XR - Backend Environment Configuration Template

PORT=4000
MONGODB_URI=mongodb://localhost:27017/safevitals
FRONTEND_URL=http://localhost:3000

# Security Keys (Generate 64-char hex strings)
SESSION_SECRET=your_32_to_64_character_cryptographic_session_secret
OTP_SECRET=your_32_to_64_character_cryptographic_otp_secret
SUPERADMIN_EMAIL=admin@safevitals.in

# Supabase Storage S3
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# GitHub OAuth2
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Transactional Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=SafeVitals XR <your_email@gmail.com>

# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
